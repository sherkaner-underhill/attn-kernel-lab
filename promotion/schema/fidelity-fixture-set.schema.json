{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attn-kernel-lab/schema/fidelity-fixture-set/1",
  "title": "Fidelity fixture set manifest",
  "description": "The hashed, versioned identity of the inputs one fidelity scorecard was computed on (plan §4.1). The manifest carries no content -- only hashes, seeds and geometry -- which is what makes a PRIVATE-lane result auditable later without disclosing anything, and what lets a public-lane result be reproduced exactly. The privacy guard is mechanical: a `private_real` set may not be `redistributable` and may not carry any in-repo path to a tensor, so a capture manifest cannot become a committed leak by accident.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_set_id",
    "lane",
    "redistributable",
    "fixture_set_sha256",
    "provenance",
    "geometry",
    "slice_semantics",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_set_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "lane": {
      "enum": ["public_synth", "public_open", "private_real"],
      "description": "The two lanes share code and share nothing else. `public_synth` is seeded synthetic tensors; `public_open` is real activations from an open-weights model on redistributable media; `private_real` is a capture that never leaves trusted infrastructure."
    },
    "redistributable": { "type": "boolean" },
    "fixture_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over this record serialised canonically (sorted keys, compact separators, UTF-8) with this field removed. Self-verifying and path-independent, which tools/tree_digest.py -- whose digest includes the file's path and mode -- cannot be for a field inside the file it digests."
    },
    "provenance": {
      "type": "object",
      "required": ["generator", "media"],
      "properties": {
        "generator": { "type": "string" },
        "generator_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "donor_instrument": { "type": "string" },
        "donor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media": {
          "type": "string",
          "description": "`NONE: ...` for a synthetic set, a licence and source for an open set, `PRIVATE:<sha256>` for a capture. Never a path."
        },
        "model": { "type": ["string", "null"] },
        "model_revision": { "type": ["string", "null"] },
        "engine": { "type": ["string", "null"] },
        "engine_revision": { "type": ["string", "null"] },
        "hook_file_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "workload_profile": { "type": ["string", "null"] },
        "workload_cases_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "workload_relationship": {
          "type": "string",
          "description": "How the fixture geometry relates to a named workload profile. A fixture set that borrows a workload's DEPTH is not a run of that workload; saying which is which is what keeps a target's workload exclusion meaningful."
        },
        "captured_utc": { "type": ["string", "null"] },
        "allocation_id": { "type": ["string", "null"] },
        "distributions": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_dim", "q_heads", "kv_heads", "page_size", "mask", "mode", "q_len"],
      "properties": {
        "head_dim": { "type": "integer" },
        "q_heads": { "type": "integer" },
        "kv_heads": { "type": "integer" },
        "page_size": { "type": "integer" },
        "mask": { "const": "bottom_right_causal" },
        "mode": { "const": "extend" },
        "q_len": { "type": "integer", "minimum": 1 },
        "sm_scale": { "type": "number" },
        "kv_dtype": { "type": "string" },
        "gen_chunk_rows": { "type": "integer" }
      }
    },
    "slice_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "row"],
      "properties": {
        "layer": { "enum": ["model_layer", "fixture_case"] },
        "row": { "enum": ["query_row"] },
        "note": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "name", "depth", "prefix"],
        "properties": {
          "layer": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "depth": { "type": "integer", "minimum": 1 },
          "prefix": { "type": "integer", "minimum": 0 },
          "chunk": { "type": ["integer", "null"] },
          "seed": { "type": ["integer", "null"] },
          "distribution": { "type": ["string", "null"] },
          "q_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "k_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "v_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "live_out_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "path": {
            "type": "string",
            "description": "Where the tensors live. Permitted only for a redistributable lane; a private capture that names a path here is rejected by tools/validate_registry.py."
          },
          "doc": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
